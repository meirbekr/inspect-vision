# ─── Inspect-Vision Environment Configuration ───────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Path to the YOLOv8 weights file (relative to project root)
# Download: https://github.com/ultralytics/assets/releases/download/v0.0.0/yolov8n.pt
# Or leave as "yolov8n.pt" to let Ultralytics auto-download on first run
MODEL_PATH=backend/models/yolov8n.pt

# Maximum allowed upload size in megabytes
MAX_FILE_SIZE_MB=10

# Path to the JSON inspection history store
STORAGE_PATH=backend/storage/inspections.json

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API host/port (optional — used for production deployments)
API_HOST=0.0.0.0
API_PORT=8000
